{
    "manifest_version": 3,
    "name": "Deckswap Importer",
    "version": "1.0.0",
    "description": "Import your Cardmarket stock into Deckswap with one click.",
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "action": {
        "default_title": "Deckswap Importer",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "background": {
        "service_worker": "src/background.ts",
        "type": "module"
    },
    "side_panel": {
        "default_path": "index.html"
    },
    "permissions": ["activeTab", "notifications", "scripting", "sidePanel", "storage", "tabs", "unlimitedStorage"],
    "host_permissions": ["https://www.cardmarket.com/*"]
}
